{
  "name": "hoddr-launchpad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Phased CCA launchpad with identity limits, ENS eligibility and token locks",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/start-local.mjs",
    "build": "vite build --configLoader runner",
    "typecheck": "tsc --noEmit",
    "test:contracts": "node scripts/forge.mjs test",
    "test:ui": "bun test tests/ui.test.tsx",
    "test:world": "node --experimental-strip-types --test tests/world.test.mjs",
    "test:sale": "bun run tests/local-sale.ts",
    "test:browser": "node tests/browser-smoke.mjs",
    "deploy:local": "node scripts/deploy-local.mjs",
    "demo:local": "bun run scripts/seed-local.ts",
    "test:partial": "bun run tests/partial-exit.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/bun": "1.3.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.1"
  }
}
